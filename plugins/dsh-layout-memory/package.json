{
  "name": "@juzi/dsh-layout-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "记住左右侧栏宽度，冷启动恢复；不接管面板开关、标签页或窗口尺寸。",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "engines": { "dsh": ">=0.2.1-rc.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-layout"] }
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "license": "MIT"
}
