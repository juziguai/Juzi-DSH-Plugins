{
  "name": "@juzi/juzi-win-dsh",
  "version": "1.1.2",
  "private": true,
  "description": "让模型看到并操作 Windows 电脑：窗口、截图、点击、输入、按键、窗口管理、拖拽悬停、等待、剪贴板、启动应用与 OCR 找字。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "server.py",
    "winapi.py",
    "security.py",
    "runlog.py",
    "confirm.py",
    "paste_text.py",
    "paste_text.ps1",
    "system_control.py",
    "system_control.ps1",
    "clipboard_win.py",
    "launcher.py",
    "ocr.py",
    "ocr_windows.ps1",
    "schema_validate.py",
    "requirements.txt",
    "requirements-dev.txt",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "smoke_test.py",
    "regression_test.py",
    "focused_text.py",
    "focused_text.ps1"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.2 <0.2.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
