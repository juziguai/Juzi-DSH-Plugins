{
  "name": "@juzi/juzi-win-dsh",
  "version": "1.1.5",
  "private": true,
  "description": "让模型看到并操作 Windows 电脑：窗口、截图、点击、输入、按键、窗口管理、拖拽悬停、等待、剪贴板、启动应用与 OCR 找字。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "server.py",
    "src/*.py",
    "scripts/*.ps1",
    "scripts/*.cs",
    "remote/*.py",
    "remote/*.ps1",
    "remote/README.md",
    "tests/*.py",
    "requirements.txt",
    "requirements-dev.txt",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.3-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.2 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
