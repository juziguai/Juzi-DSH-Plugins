{
  "name": "@juzi/dsh-memory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "通过官方 MCP 接入 LocalMemory 的项目记忆与证据管理。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-tool-executor-native": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
